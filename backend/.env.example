# DATABASE_URL: deixe em branco para usar o default (SQLite em backend/trixlog.db, caminho
# absoluto — funciona rodando de qualquer diretório). Descomente para trocar por Postgres/Supabase:
# DATABASE_URL=postgresql://postgres:SENHA@db.SEUPROJETO.supabase.co:5432/postgres

# Reservado para quando os agentes forem orquestrados via Claude API (fora do escopo desta Fase 0/1).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

ENVIRONMENT=development
